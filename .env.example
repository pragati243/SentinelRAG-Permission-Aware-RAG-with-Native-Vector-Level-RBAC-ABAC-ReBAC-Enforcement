# Copy to .env and fill in real values. .env is gitignored -- never commit real secrets.

# JWT signing secret for issued identity tokens (backend/services/auth_service.py).
# MUST be overridden with a strong random value outside local dev.
JWT_SECRET_KEY=
JWT_EXPIRY_MINUTES=30

# Groq API key -- used as the LLM judge for guardrail checks (prompt-injection
# detection, answer groundedness verification) in backend/services/guardrail_service.py.
# Get one at https://console.groq.com. Guardrails fail OPEN (log-only, non-blocking)
# when this is unset, so the app runs fine without it -- just without LLM-judged checks.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
